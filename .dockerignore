# --- Dependencies (reinstalled inside the image) ---
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Version control / metadata ---
.git/
.gitignore
.gitattributes
.github/

# --- Docker files themselves (not needed inside the image) ---
Dockerfile
**/Dockerfile
docker-compose.yml
compose.yaml
.dockerignore

# --- Docs / editor / OS ---
README.md
*.md
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- Env / secrets (never bake into images) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Build output / coverage ---
dist/
build/
coverage/
.nyc_output/
*.log

# --- Tests / temp ---
tmp/
temp/
